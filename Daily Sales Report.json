        "jsCode": "const today = $now.setZone('Asia/Bangkok').toISODate();\nconst monday = new Date(today + 'T00:00:00Z');\nmonday.setUTCDate(monday.getUTCDate() - (monday.getUTCDay() + 6) % 7);\n\nconst periods = [\n  ['วันนี้', today],\n  ['สัปดาห์นี้', monday.toISOString().slice(0, 10)],\n  ['เดือนนี้', today.slice(0, 7) + '-01'],\n  ['ปีนี้', today.slice(0, 4) + '-01-01'],\n];\n\nconst sales = $input.all().map(item => item.json)\n  .filter(row => String(row['สถานะ'] ?? '').trim() === 'บันทึกแล้ว')\n  .map(row => {\n    const date = String(row['วันที่ขาย'] ?? '').trim();\n    const parsed = new Date(date + 'T00:00:00Z');\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) ||\n        !Number.isFinite(parsed.getTime()) ||\n        parsed.toISOString().slice(0, 10) !== date) {\n      throw new Error('วันที่ขายไม่ถูกต้อง แถว ' + row.row_number);\n    }\n    const amount = Number(String(row['ยอดรวม'] ?? '').replace(/,/g, ''));\n    const cups = Number(row['จำนวนแก้ว']);\n    if (row['ยอดรวม'] == null || String(row['ยอดรวม']).trim() === '' ||\n        !Number.isFinite(amount) || amount < 0 ||\n        !Number.isSafeInteger(cups) || cups < 1) {\n      throw new Error('ตัวเลขยอดขายไม่ถูกต้อง แถว ' + row.row_number);\n    }\n    return { date, cents: Math.round(amount * 100), cups };\n  });\n\nconst reports = periods.map(([label, from]) => {\n  const rows = sales.filter(sale => sale.date >= from && sale.date <= today);\n  return {\n    label, from, to: today,\n    transactions: rows.length,\n    cups: rows.reduce((sum, sale) => sum + sale.cups, 0),\n    total: rows.reduce((sum, sale) => sum + sale.cents, 0) / 100,\n  };\n});\n\n\nconst viaLine = $('Webhook').isExecuted;\nlet command = '';\nlet recipientId = 'YOUR_LINE_REPORT_RECIPIENT_ID';\nif (viaLine) {\n  const event = $('Webhook').first().json.body.events[0];\n  recipientId = event.source?.userId;\n  const allowed = $('Get row(s) in sheet4').all().some(item =>\n    item.json['LINE User ID'] === recipientId &&\n    item.json['สถานะ'] === 'ใช้งาน'\n  );\n  if (!allowed) throw new Error('ไม่มีสิทธิ์ดูรายงานยอดขาย');\n  command = (event.message?.text ?? '').replace(/[\\u200B-\\u200D\\uFEFF]/g, '').trim().replace(/^ยอดขาย/, 'ยอด').replace(/อาทิตย์/g, 'สัปดาห์');\n}\nconst commandLabels = {\n  'ยอดวันนี้': 'วันนี้',\n  'ยอดสัปดาห์นี้': 'สัปดาห์นี้',\n  'ยอดเดือนนี้': 'เดือนนี้',\n  'ยอดปีนี้': 'ปีนี้',\n};\nif (viaLine && !commandLabels[command]) throw new Error('คำสั่งรายงานไม่ถูกต้อง');\nconst selectedReports = viaLine\n  ? reports.filter(report => report.label === commandLabels[command])\n  : reports;\n\nconst message = 'สรุปยอดขาย ณ วันที่ ' + today + '\\n\\n' + selectedReports.map(r =>\n  r.label + ': ' + r.total.toLocaleString('th-TH', {\n    minimumFractionDigits: 2, maximumFractionDigits: 2,\n  }) + ' บาท\\n' + r.cups + ' แก้ว / ' + r.transactions + ' รายการ'\n).join('\\n\\n');\n\nreturn [{ json: { today, reports, message, recipientId } }];\n"
      },
